#!/bin/bash
# omarchy-auto-update — background update checks for the Omarchy Auto Update plugin.
#
#   omarchy-auto-update run [--force]   check, download and verify, then write the state
#   omarchy-auto-update status          print the last state as JSON
#   omarchy-auto-update ack-news        mark the current Arch news as read
#   omarchy-auto-update ack-run         dismiss a finished update
#   omarchy-auto-update update-now      open Omarchy's own updater (terminal fallback)
#   omarchy-auto-update after-restart   after an update installed on restart: check the
#                                       session and list what is left to finish
#   omarchy-auto-update ack-applied     dismiss the result of an update installed on restart
#
# Nothing here needs root or touches the system: the package databases are
# synced into a private copy and packages are downloaded into a private cache,
# both under ~/.cache/omarchy-auto-update. Arch does not support partial
# upgrades, so the whole pending set is always fetched and judged together.
# Installing on restart is bin/omarchy-auto-update-offline, run as root; this
# only reads what it leaves in /var/lib/omarchy-auto-update.

set -euo pipefail

BASE="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-auto-update"
DB="$BASE/db"
PKG="$BASE/pkg"
STATE="$BASE/state.json"
NEWS_SEEN="$BASE/news-seen"
LOCK="$BASE/run.lock"
MIN_FREE_BYTES=$((10 * 1024 * 1024 * 1024)) # same floor as omarchy update
VALID_SECONDS=$((3 * 24 * 3600))            # re-prepare after three days
NEWS_URL="https://archlinux.org/feeds/news/"
SPOOL="${OMARCHY_AUTO_UPDATE_SPOOL:-/var/lib/omarchy-auto-update}" # written by the offline installer
TRIGGER="${OMARCHY_AUTO_UPDATE_TRIGGER:-/system-update}"
APPLIED_SEEN="$BASE/applied-seen"
HEALTH="$BASE/health.json"

# A set that touches any of these is installed on restart, never under a
# running session: kernel and boot chain, core libraries, graphics, the shell
# and its toolkit, the compositor, and Omarchy itself.
RESTART_PATTERN='^(linux|linux-[a-z0-9-]+|linux-firmware.*|glibc|systemd|systemd-[a-z-]+|dbus.*|mesa|lib32-mesa|vulkan-.*|nvidia.*|qt6-.*|quickshell.*|hyprland.*|aquamarine|wayland|xdg-desktop-portal.*|limine.*|mkinitcpio.*|grub|omarchy.*|pacman|openssl|cryptsetup|btrfs-progs|snapper)$'

die() { echo "omarchy-auto-update: $*" >&2; exit 1; }
now() { date +%s; }

write_state() {
  mkdir -p "$BASE"
  local tmp
  tmp=$(mktemp "$BASE/.state.XXXXXX")
  jq -n "$@" >"$tmp" && mv -f "$tmp" "$STATE"
}

# Signatures are only "verified" when pacman requires them.
signatures_required() {
  # Package signatures: plain Never/Optional or PackageNever/PackageOptional
  # turn them off; DatabaseOptional only concerns the databases.
  ! grep -E '^[[:space:]]*SigLevel[[:space:]]*=' /etc/pacman.conf |
    grep -Eq '(=|[[:space:]])(Package)?(Never|Optional)([[:space:]]|$)'
}

# State with no package set: idle reasons and errors.
simple_state() {
  local state="$1" message="${2:-}"
  write_state --arg state "$state" --arg message "$message" --argjson at "$(now)" \
    '{state: $state, message: $message, checkedAt: $at, packages: [], count: 0}'
}

on_metered() {
  local dev metered
  dev=$(ip route show default 2>/dev/null | awk '{print $5; exit}')
  [[ -n $dev ]] || return 1
  metered=$(nmcli -t -g GENERAL.METERED dev show "$dev" 2>/dev/null || true)
  [[ $metered == yes* ]]
}

# True on a laptop running on battery below 50%. Peripheral batteries (mice,
# keyboards) report scope=Device and are ignored.
low_battery() {
  local b ac_online=0 low=1 found=0
  for b in /sys/class/power_supply/*; do
    [[ -f $b/type ]] || continue
    case "$(cat "$b/type")" in
      Mains) [[ $(cat "$b/online" 2>/dev/null) == 1 ]] && ac_online=1 ;;
      Battery)
        [[ $(cat "$b/scope" 2>/dev/null) == Device ]] && continue
        found=1
        (($(cat "$b/capacity" 2>/dev/null || echo 100) >= 50)) && low=0
        ;;
    esac
  done
  ((found == 1 && ac_online == 0 && low == 1))
}

sync_db() {
  mkdir -p "$DB" "$PKG"
  # Tests point this at a copy of the local database with older versions.
  ln -sfn "${OMARCHY_AUTO_UPDATE_LOCAL_DB:-/var/lib/pacman/local}" "$DB/local"
  fakeroot -- pacman -Sy --disable-sandbox-filesystem --dbpath "$DB" --logfile /dev/null >/dev/null 2>&1
}

# Newest Arch news item as "epoch<TAB>title<TAB>link", or nothing.
latest_news() {
  curl -fsSL --max-time 15 "$NEWS_URL" 2>/dev/null | python3 -c '
import sys, email.utils, xml.etree.ElementTree as ET
try:
    item = ET.parse(sys.stdin).getroot().find("channel/item")
    when = int(email.utils.parsedate_to_datetime(item.findtext("pubDate")).timestamp())
    title, link = item.findtext("title").strip(), item.findtext("link").strip()
    print(f"{when}\t{title}\t{link}")
except Exception:
    pass
' || true
}

run() {
  local force="${1:-}"
  mkdir -p "$BASE"
  exec 9>"$LOCK"
  flock -n 9 || die "a check is already running"

  if [[ $force != --force && -f $STATE ]]; then
    local valid
    # Only a plain integer may reach the arithmetic below.
    valid=$(jq -r 'if (.validUntil | type) == "number" then (.validUntil | floor) else 0 end' "$STATE" 2>/dev/null || echo 0)
    [[ $valid =~ ^[0-9]{1,12}$ ]] || valid=0
    # A prepared set stays good until it expires or a restart installed one.
    if [[ $(jq -r .state "$STATE" 2>/dev/null) == ready ]] && (($(now) < valid)) &&
      ! [[ $SPOOL/result.json -nt $STATE ]]; then
      cat "$STATE"
      return
    fi
  fi

  simple_state checking "Checking for updates"
  if ! sync_db; then
    simple_state error "Couldn't reach the package mirrors"
    cat "$STATE"
    return 1
  fi

  # name old -> new, ignoring held packages.
  local pending qu_err
  qu_err=$(mktemp)
  pending=$(pacman -Qu --dbpath "$DB" 2>"$qu_err" | grep -v '\[ignored\]' || true)
  if grep -q '^error:' "$qu_err"; then
    simple_state error "Couldn't read the package list: $(head -1 "$qu_err")"
    rm -f "$qu_err"
    cat "$STATE"
    return 1
  fi
  rm -f "$qu_err"
  if [[ -z $pending ]]; then
    simple_state uptodate "Omarchy is up to date"
    cat "$STATE"
    return
  fi

  # The full transaction pacman would run, with download sizes. A failure here
  # means the set needs a human (a conflict or a question) before it can go in.
  local plan
  if ! plan=$(fakeroot -- pacman -Su --print --print-format '%n %v %s' --noconfirm \
    --disable-sandbox-filesystem --dbpath "$DB" --cachedir "$PKG" --logfile /dev/null 2>"$BASE/plan.err"); then
    write_state --arg message "This update needs a decision. Run Omarchy's updater to see it." \
      --arg detail "$(tail -3 "$BASE/plan.err")" --argjson at "$(now)" \
      '{state: "attention", reason: "needs-decision", message: $message, detail: $detail, checkedAt: $at, packages: [], count: 0}'
    cat "$STATE"
    return
  fi

  local free
  free=$(df --output=avail -B1 / | tail -1 | tr -d ' ')
  if ((free < MIN_FREE_BYTES)); then
    simple_state attention "Not enough free space: Omarchy needs 10 GB free to update safely"
    cat "$STATE"
    return
  fi

  local waiting=""
  if on_metered; then
    waiting="Waiting for a non-metered connection to download"
  elif low_battery; then
    waiting="Waiting for power to download"
  fi

  local downloaded=false
  if [[ -z $waiting ]]; then
    simple_state downloading "Downloading updates"
    # pacman checks every signature and checksum while downloading.
    if nice -n 10 ionice -c3 fakeroot -- pacman -Suw --noconfirm --disable-sandbox-filesystem \
      --dbpath "$DB" --cachedir "$PKG" --logfile /dev/null >"$BASE/download.log" 2>&1; then
      downloaded=true
    else
      write_state --arg message "Download or verification failed. It will be retried." \
        --arg detail "$(tail -3 "$BASE/download.log")" --argjson at "$(now)" \
        '{state: "error", message: $message, detail: $detail, checkedAt: $at, packages: [], count: 0}'
      cat "$STATE"
      return 1
    fi
    # Packages from earlier sets that are no longer pending.
    find "$PKG" -maxdepth 1 -type f -mtime +14 -delete 2>/dev/null || true
  fi

  # Arch news newer than the last one the user acknowledged.
  local news seen
  news=$(latest_news)
  seen=$(cat "$NEWS_SEEN" 2>/dev/null || echo 0)

  local state=ready verified=false
  [[ -n $waiting ]] && state=waiting
  [[ $downloaded == true ]] && signatures_required && verified=true
  printf '%s\n' "$pending" | python3 -c '
import hashlib, json, re, sys
pending, plan, restart_re, state, waiting, downloaded, news, seen, now, valid, verified = sys.argv[1:12]
restart = re.compile(restart_re)

packages = []
for line in pending.splitlines():
    parts = line.split()
    if len(parts) >= 4 and parts[2] == "->":
        packages.append({"name": parts[0], "from": parts[1], "to": parts[3]})

size = 0
names = set(p["name"] for p in packages)
transaction = []
for line in plan.splitlines():
    parts = line.split()
    if len(parts) == 3 and parts[2].isdigit():
        size += int(parts[2])
        transaction.append(f"{parts[0]} {parts[1]}")
        if parts[0] not in names:
            packages.append({"name": parts[0], "from": "", "to": parts[1]})

reasons = sorted(p["name"] for p in packages if restart.match(p["name"]))
omarchy = next((p for p in packages if p["name"] in ("omarchy", "omarchy-dev")), None)
tier = "small"
if reasons:
    tier = "restart"
if omarchy and omarchy["from"]:
    mm = lambda v: ".".join(re.split(r"[.-]", v)[:2])
    if mm(omarchy["from"]) != mm(omarchy["to"]):
        tier = "major"

out = {
    "state": state,
    "message": waiting or {"small": "Updates are ready", "restart": "Updates are ready. Restart to finish",
                           "major": "A new version of Omarchy is ready"}[tier],
    "tier": tier,
    "restartReasons": reasons,
    "omarchy": omarchy,
    "packages": sorted(packages, key=lambda p: (not restart.match(p["name"]), p["name"])),
    "count": len(packages),
    # What the user agrees to: the whole transaction, as "name version" lines.
    # The runner and bin/omarchy-auto-update-offline (as root) install only if
    # their own plan gives the same value.
    "fingerprint": hashlib.sha256("\n".join(sorted(transaction)).encode()).hexdigest(),
    "downloadBytes": size,
    "downloaded": downloaded == "true",
    "verified": verified == "true",
    "checkedAt": int(now),
    "validUntil": int(now) + int(valid),
}
if news:
    when, title, link = news.split("\t")
    if int(when) > int(seen or 0):
        out["news"] = {"at": int(when), "title": title, "link": link}
print(json.dumps(out))
' "$pending" "$plan" "$RESTART_PATTERN" "$state" "$waiting" "$downloaded" "$news" "$seen" "$(now)" "$VALID_SECONDS" "$verified" >"$BASE/.state.new"
  mv -f "$BASE/.state.new" "$STATE"
  cat "$STATE"
}

RUN_EVENTS="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-auto-update/run.jsonl"

status() {
  local s='{"state":"unknown","packages":[],"count":0}'
  [[ -f $STATE ]] && s=$(cat "$STATE")
  # An update started from the overlay that the user hasn't dismissed yet. If
  # its process is gone without saying it finished, record that it stopped.
  if [[ -f $RUN_EVENTS ]] && ! grep -q '"type": "done"' "$RUN_EVENTS"; then
    local lockf="${RUN_EVENTS%/*}/run.lock"
    if [[ -f $lockf ]] && flock -n "$lockf" true 2>/dev/null; then
      echo '{"type": "done", "ok": false, "error": "The update stopped unexpectedly. Run Omarchy update to finish it."}' >>"$RUN_EVENTS"
    fi
  fi
  [[ -f $RUN_EVENTS ]] && s=$(jq -c '. + {run: true}' <<<"$s" 2>/dev/null || echo "$s")
  offline_state "$s"
}

# What the offline installer left: a set waiting for a restart, and the result
# of the last restart that installed one, until the user has seen it.
offline_state() {
  local s="$1" staged=null applied=null health=null id
  if [[ $(readlink "$TRIGGER" 2>/dev/null) == "$SPOOL/staged" ]]; then
    staged=$(jq -c '{fingerprint, stagedAt, count}' "$SPOOL/staged/omarchy-auto-update.json" 2>/dev/null) || staged=null
  fi
  id=$(jq -r '.id // empty' "$SPOOL/result.json" 2>/dev/null || true)
  if [[ -n $id && $id != "$(cat "$APPLIED_SEEN" 2>/dev/null)" ]]; then
    applied=$(jq -c . "$SPOOL/result.json" 2>/dev/null) || applied=null
    if [[ $(jq -r .id "$HEALTH" 2>/dev/null) == "$id" ]]; then
      health=$(jq -c . "$HEALTH" 2>/dev/null) || health=null
    fi
  fi
  jq -c --argjson staged "${staged:-null}" --argjson applied "${applied:-null}" --argjson health "${health:-null}" \
    '. + {restartPending: $staged, applied: $applied, health: $health}' <<<"$s" 2>/dev/null || echo "$s"
}

failed_units() {
  systemctl "$@" --failed --no-legend --plain 2>/dev/null | awk '{print $1}' | jq -Rsc 'split("\n") | map(select(length > 0))'
}

# Called by the runner right before staging, so the check after the restart
# only counts what broke since.
baseline() {
  mkdir -p "$BASE"
  jq -n --argjson system "$(failed_units)" --argjson user "$(failed_units --user)" \
    '{system: $system, user: $user}' >"$BASE/failed-before.json"
}

# After an update installed on restart: did the session come up whole, and what
# is left to finish. Migrations ship with Omarchy and run as the user, so they
# could not run during the restart; those that call sudo need the password.
after_restart() {
  local id
  id=$(jq -r '.id // empty' "$SPOOL/result.json" 2>/dev/null || true)
  if [[ -z $id || $id == "$(cat "$APPLIED_SEEN" 2>/dev/null)" ]]; then
    echo '{}'
    return
  fi
  local before='{"system": [], "user": []}' hypr=false shell=false
  [[ -f $BASE/failed-before.json ]] && before=$(cat "$BASE/failed-before.json")
  hyprctl version >/dev/null 2>&1 && hypr=true
  pgrep -u "$(id -u)" -x quickshell >/dev/null && shell=true
  local pending needs=false dir="${OMARCHY_PATH:-/usr/share/omarchy}/migrations" m
  pending=$(omarchy-migrate --pending 2>/dev/null || true)
  while IFS= read -r m; do
    [[ -n $m ]] && grep -qw sudo "$dir/$m" 2>/dev/null && needs=true
  done <<<"$pending"
  mkdir -p "$BASE"
  jq -n --arg id "$id" --argjson before "$before" --argjson system "$(failed_units)" \
    --argjson user "$(failed_units --user)" --argjson hypr "$hypr" --argjson shell "$shell" \
    --arg pending "$pending" --argjson needs "$needs" --argjson at "$(now)" '
    ($system - ($before.system // [])) as $newSystem | ($user - ($before.user // [])) as $newUser |
    {id: $id, at: $at, hyprland: $hypr, shell: $shell, failed: ($newSystem + $newUser),
     ok: ($hypr and $shell and ($newSystem + $newUser | length) == 0),
     migrations: ($pending | split("\n") | map(select(length > 0))), needsPassword: $needs}' >"$HEALTH.tmp"
  mv -f "$HEALTH.tmp" "$HEALTH"
  cat "$HEALTH"
}

ack_applied() {
  local id
  id=$(jq -r '.id // empty' "$SPOOL/result.json" 2>/dev/null || true)
  [[ -n $id ]] && { mkdir -p "$BASE"; echo "$id" >"$APPLIED_SEEN"; }
  return 0
}

ack_news() {
  local news tmp
  news=$(latest_news)
  [[ -n $news ]] || return 0
  mkdir -p "$BASE"
  exec 9>"$LOCK"
  flock -w 30 9 || die "a check is running; try again"
  cut -f1 <<<"$news" >"$NEWS_SEEN"
  if [[ -f $STATE ]]; then
    tmp=$(mktemp "$BASE/.state.XXXXXX")
    jq 'del(.news)' "$STATE" >"$tmp" && mv -f "$tmp" "$STATE"
  fi
  status
}

# Called when the user dismisses a finished update in the overlay.
ack_run() {
  [[ -f $RUN_EVENTS ]] && mv -f "$RUN_EVENTS" "$RUN_EVENTS.seen"
  return 0
}

update_now() {
  local launcher=omarchy-launch-floating-terminal-with-presentation
  command -v "$launcher" >/dev/null || launcher="${OMARCHY_PATH:-/usr/share/omarchy}/bin/$launcher"
  setsid -f "$launcher" omarchy-update >/dev/null 2>&1 </dev/null
}

cmd="${1:-}"
shift || true
case "$cmd" in
  run) run "${1:-}" ;;
  status) status ;;
  ack-news) ack_news ;;
  ack-run) ack_run ;;
  after-restart) after_restart ;;
  ack-applied) ack_applied ;;
  baseline) baseline ;;
  update-now) update_now ;;
  -h | --help | help | "") awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0" ;;
  *) die "unknown command: $cmd (see --help)" ;;
esac
