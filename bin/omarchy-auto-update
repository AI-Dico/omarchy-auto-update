#!/bin/bash
# omarchy-auto-update — background update checks for the Omarchy Auto Update plugin.
#
#   omarchy-auto-update run [--force]   check, download and verify, then write the state
#   omarchy-auto-update status          print the last state as JSON
#   omarchy-auto-update ack-news        mark the current Arch news as read
#   omarchy-auto-update ack-run         dismiss a finished update
#   omarchy-auto-update update-now      open Omarchy's own updater (terminal fallback)
#   omarchy-auto-update after-restart   after an update installed on restart: check the
#                                       session and list what is left to finish
#   omarchy-auto-update ack-applied     dismiss the result of an update installed on restart
#   omarchy-auto-update last-applied    the last update installed on restart, for the overlay
#   omarchy-auto-update config get      print the settings as JSON
#   omarchy-auto-update config set icon-mode <always|updates|important|hidden>
#                                       when the bar icon shows: always when there is
#                                       something to say, only when it needs you, never
#   omarchy-auto-update notify          tell the user about news the bar icon can't show
#                                       right now (once per set or state)
#   omarchy-auto-update menu-install [--auto]
#                                       add "Auto Update" under Update in the Omarchy menu
#   omarchy-auto-update menu-remove     take it out again
#   omarchy-auto-update rollback-info   whether the last update installed on restart can
#                                       be tried without, and from which boot entry
#   omarchy-auto-update try-restore     restart once into the restore point taken before it
#   omarchy-auto-update snapshot-state  whether this boot is a restore point, and ours
#   omarchy-auto-update return-updated  from a restore point, restart into the normal system
#   omarchy-auto-update keep-restore    from a restore point, keep it for good (password)
#                                       and restart; the update is held back after it
#   omarchy-auto-update install-again   offer the held-back update again
#
# Nothing here needs root or touches the system: the package databases are
# synced into a private copy and packages are downloaded into a private cache,
# both under ~/.cache/omarchy-auto-update. Arch does not support partial
# upgrades, so the whole pending set is always fetched and judged together.
# Installing on restart is bin/omarchy-auto-update-offline, run as root; this
# only reads what it leaves in /var/lib/omarchy-auto-update.

set -euo pipefail

BASE="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-auto-update"
DB="$BASE/db"
PKG="$BASE/pkg"
STATE="$BASE/state.json"
NEWS_SEEN="$BASE/news-seen"
LOCK="$BASE/run.lock"
MIN_FREE_BYTES=$((10 * 1024 * 1024 * 1024)) # same floor as omarchy update
VALID_SECONDS=$((3 * 24 * 3600))            # re-prepare after three days
NEWS_URL="https://archlinux.org/feeds/news/"
SPOOL="${OMARCHY_AUTO_UPDATE_SPOOL:-/var/lib/omarchy-auto-update}" # written by the offline installer
TRIGGER="${OMARCHY_AUTO_UPDATE_TRIGGER:-/system-update}"
APPLIED_SEEN="$BASE/applied-seen"
HEALTH="$BASE/health.json"
NOTIFIED="$BASE/notified"
MENU_MARK="$BASE/menu-installed"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-auto-update"
CONFIG="$CONFIG_DIR/config.json"
PLUGIN_ID="io.github.ai-dico.auto-update"
SELF=$(readlink -f "${BASH_SOURCE[0]}")
SUMMON="omarchy-shell shell summon $PLUGIN_ID {}"
MENU_EXT="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
MENU_BEGIN="  // >>> omarchy-auto-update (managed by $PLUGIN_ID, edit outside this block)"
MENU_END="  // <<< omarchy-auto-update"
# Trying a restore point: kept in the home subvolume, which going back never touches.
ROLLBACK="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-auto-update/rollback.json"
# Omarchy's own "Restore now" note, which opens a terminal; hidden only for a try we started.
RESTORE_NOTE="${XDG_CONFIG_HOME:-$HOME/.config}/autostart/limine-restore-notify.desktop"
EFIVARS="${OMARCHY_AUTO_UPDATE_EFIVARS:-/sys/firmware/efi/efivars}"
CMDLINE="${OMARCHY_AUTO_UPDATE_CMDLINE:-/proc/cmdline}"
SYSTEMCTL="${OMARCHY_AUTO_UPDATE_SYSTEMCTL:-/usr/bin/systemctl}"
# Choosing the next boot entry needs root: logind only knows systemd-style
# entries, not Limine's, so the request goes to the EFI variable through
# bootctl, with Omarchy's password dialog (polkit).
PKEXEC="${OMARCHY_AUTO_UPDATE_PKEXEC:-/usr/bin/pkexec}"
BOOTCTL=/usr/bin/bootctl
# Keeping a restore point is Limine's own restore, run on a pseudo-terminal it
# needs (it reads its answers line by line from one).
SCRIPT="${OMARCHY_AUTO_UPDATE_SCRIPT:-/usr/bin/script}"
LSS="${OMARCHY_AUTO_UPDATE_LSS:-/usr/bin/limine-snapper-sync}"
RESTORE_LOG="$BASE/restore.log"
# An update the user went back from: not offered again until a newer set comes.
HELD="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-auto-update/held.json"

# A set that touches any of these is installed on restart, never under a
# running session: kernel and boot chain, core libraries, graphics, the shell
# and its toolkit, the compositor, and Omarchy itself.
RESTART_PATTERN='^(linux|linux-[a-z0-9-]+|linux-firmware.*|glibc|systemd|systemd-[a-z-]+|dbus.*|mesa|lib32-mesa|vulkan-.*|nvidia.*|qt6-.*|quickshell.*|hyprland.*|aquamarine|wayland|xdg-desktop-portal.*|limine.*|mkinitcpio.*|grub|omarchy.*|pacman|openssl|cryptsetup|btrfs-progs|snapper)$'

die() { echo "omarchy-auto-update: $*" >&2; exit 1; }
now() { date +%s; }

write_state() {
  mkdir -p "$BASE"
  local tmp
  tmp=$(mktemp "$BASE/.state.XXXXXX")
  jq -n "$@" >"$tmp" && mv -f "$tmp" "$STATE"
}

# Signatures are only "verified" when pacman requires them.
signatures_required() {
  # Package signatures: plain Never/Optional or PackageNever/PackageOptional
  # turn them off; DatabaseOptional only concerns the databases.
  ! grep -E '^[[:space:]]*SigLevel[[:space:]]*=' /etc/pacman.conf |
    grep -Eq '(=|[[:space:]])(Package)?(Never|Optional)([[:space:]]|$)'
}

# State with no package set: idle reasons and errors.
simple_state() {
  local state="$1" message="${2:-}"
  write_state --arg state "$state" --arg message "$message" --argjson at "$(now)" \
    '{state: $state, message: $message, checkedAt: $at, packages: [], count: 0}'
}

on_metered() {
  local dev metered
  dev=$(ip route show default 2>/dev/null | awk '{print $5; exit}')
  [[ -n $dev ]] || return 1
  metered=$(nmcli -t -g GENERAL.METERED dev show "$dev" 2>/dev/null || true)
  [[ $metered == yes* ]]
}

# True on a laptop running on battery below 50%. Peripheral batteries (mice,
# keyboards) report scope=Device and are ignored.
low_battery() {
  local b ac_online=0 low=1 found=0
  for b in /sys/class/power_supply/*; do
    [[ -f $b/type ]] || continue
    case "$(cat "$b/type")" in
      Mains) [[ $(cat "$b/online" 2>/dev/null) == 1 ]] && ac_online=1 ;;
      Battery)
        [[ $(cat "$b/scope" 2>/dev/null) == Device ]] && continue
        found=1
        (($(cat "$b/capacity" 2>/dev/null || echo 100) >= 50)) && low=0
        ;;
    esac
  done
  ((found == 1 && ac_online == 0 && low == 1))
}

sync_db() {
  mkdir -p "$DB" "$PKG"
  # Tests point this at a copy of the local database with older versions.
  ln -sfn "${OMARCHY_AUTO_UPDATE_LOCAL_DB:-/var/lib/pacman/local}" "$DB/local"
  fakeroot -- pacman -Sy --disable-sandbox-filesystem --dbpath "$DB" --logfile /dev/null >/dev/null 2>&1
}

# Newest Arch news item as "epoch<TAB>title<TAB>link", or nothing.
latest_news() {
  curl -fsSL --max-time 15 "$NEWS_URL" 2>/dev/null | python3 -c '
import sys, email.utils, xml.etree.ElementTree as ET
try:
    item = ET.parse(sys.stdin).getroot().find("channel/item")
    when = int(email.utils.parsedate_to_datetime(item.findtext("pubDate")).timestamp())
    title, link = item.findtext("title").strip(), item.findtext("link").strip()
    print(f"{when}\t{title}\t{link}")
except Exception:
    pass
' || true
}

run() {
  local force="${1:-}"
  mkdir -p "$BASE"
  exec 9>"$LOCK"
  flock -n 9 || die "a check is already running"

  # A restore point is read-only and only being tried: no updates from it.
  # The saved state is left for the normal system.
  if [[ -n $(booted_snapshot) ]]; then
    status
    return 0
  fi

  if [[ $force != --force && -f $STATE ]]; then
    local valid
    # Only a plain integer may reach the arithmetic below.
    valid=$(jq -r 'if (.validUntil | type) == "number" then (.validUntil | floor) else 0 end' "$STATE" 2>/dev/null || echo 0)
    [[ $valid =~ ^[0-9]{1,12}$ ]] || valid=0
    # A prepared set stays good until it expires or a restart installed one.
    if [[ $(jq -r .state "$STATE" 2>/dev/null) == ready ]] && (($(now) < valid)) &&
      ! [[ $SPOOL/result.json -nt $STATE ]]; then
      cat "$STATE"
      return
    fi
  fi

  simple_state checking "Checking for updates"
  if ! sync_db; then
    simple_state error "Couldn't reach the package mirrors"
    cat "$STATE"
    return 1
  fi

  # name old -> new, ignoring held packages.
  local pending qu_err
  qu_err=$(mktemp)
  pending=$(pacman -Qu --dbpath "$DB" 2>"$qu_err" | grep -v '\[ignored\]' || true)
  if grep -q '^error:' "$qu_err"; then
    simple_state error "Couldn't read the package list: $(head -1 "$qu_err")"
    rm -f "$qu_err"
    cat "$STATE"
    return 1
  fi
  rm -f "$qu_err"
  if [[ -z $pending ]]; then
    simple_state uptodate "Omarchy is up to date"
    cat "$STATE"
    return
  fi

  # The full transaction pacman would run, with download sizes. A failure here
  # means the set needs a human (a conflict or a question) before it can go in.
  local plan
  if ! plan=$(fakeroot -- pacman -Su --print --print-format '%n %v %s' --noconfirm \
    --disable-sandbox-filesystem --dbpath "$DB" --cachedir "$PKG" --logfile /dev/null 2>"$BASE/plan.err"); then
    write_state --arg message "This update needs a decision. Run Omarchy's updater to see it." \
      --arg detail "$(tail -3 "$BASE/plan.err")" --argjson at "$(now)" \
      '{state: "attention", reason: "needs-decision", message: $message, detail: $detail, checkedAt: $at, packages: [], count: 0}'
    cat "$STATE"
    return
  fi

  local free
  free=$(df --output=avail -B1 / | tail -1 | tr -d ' ')
  if ((free < MIN_FREE_BYTES)); then
    simple_state attention "Not enough free space: Omarchy needs 10 GB free to update safely"
    cat "$STATE"
    return
  fi

  local waiting=""
  if on_metered; then
    waiting="Waiting for a non-metered connection to download"
  elif low_battery; then
    waiting="Waiting for power to download"
  fi

  local downloaded=false
  if [[ -z $waiting ]]; then
    simple_state downloading "Downloading updates"
    # pacman checks every signature and checksum while downloading.
    if nice -n 10 ionice -c3 fakeroot -- pacman -Suw --noconfirm --disable-sandbox-filesystem \
      --dbpath "$DB" --cachedir "$PKG" --logfile /dev/null >"$BASE/download.log" 2>&1; then
      downloaded=true
    else
      write_state --arg message "Download or verification failed. It will be retried." \
        --arg detail "$(tail -3 "$BASE/download.log")" --argjson at "$(now)" \
        '{state: "error", message: $message, detail: $detail, checkedAt: $at, packages: [], count: 0}'
      cat "$STATE"
      return 1
    fi
    # Packages from earlier sets that are no longer pending.
    find "$PKG" -maxdepth 1 -type f -mtime +14 -delete 2>/dev/null || true
  fi

  # Arch news newer than the last one the user acknowledged.
  local news seen
  news=$(latest_news)
  seen=$(cat "$NEWS_SEEN" 2>/dev/null || echo 0)

  local state=ready verified=false
  [[ -n $waiting ]] && state=waiting
  [[ $downloaded == true ]] && signatures_required && verified=true
  printf '%s\n' "$pending" | python3 -c '
import hashlib, json, re, sys
pending, plan, restart_re, state, waiting, downloaded, news, seen, now, valid, verified = sys.argv[1:12]
restart = re.compile(restart_re)

packages = []
for line in pending.splitlines():
    parts = line.split()
    if len(parts) >= 4 and parts[2] == "->":
        packages.append({"name": parts[0], "from": parts[1], "to": parts[3]})

size = 0
names = set(p["name"] for p in packages)
transaction = []
for line in plan.splitlines():
    parts = line.split()
    if len(parts) == 3 and parts[2].isdigit():
        size += int(parts[2])
        transaction.append(f"{parts[0]} {parts[1]}")
        if parts[0] not in names:
            packages.append({"name": parts[0], "from": "", "to": parts[1]})

reasons = sorted(p["name"] for p in packages if restart.match(p["name"]))
omarchy = next((p for p in packages if p["name"] in ("omarchy", "omarchy-dev")), None)
tier = "small"
if reasons:
    tier = "restart"
if omarchy and omarchy["from"]:
    mm = lambda v: ".".join(re.split(r"[.-]", v)[:2])
    if mm(omarchy["from"]) != mm(omarchy["to"]):
        tier = "major"

out = {
    "state": state,
    "message": waiting or {"small": "Updates are ready", "restart": "Updates are ready. Restart to finish",
                           "major": "A new version of Omarchy is ready"}[tier],
    "tier": tier,
    "restartReasons": reasons,
    "omarchy": omarchy,
    "packages": sorted(packages, key=lambda p: (not restart.match(p["name"]), p["name"])),
    "count": len(packages),
    # What the user agrees to: the whole transaction, as "name version" lines.
    # The runner and bin/omarchy-auto-update-offline (as root) install only if
    # their own plan gives the same value.
    "fingerprint": hashlib.sha256("\n".join(sorted(transaction)).encode()).hexdigest(),
    "downloadBytes": size,
    "downloaded": downloaded == "true",
    "verified": verified == "true",
    "checkedAt": int(now),
    "validUntil": int(now) + int(valid),
}
if news:
    when, title, link = news.split("\t")
    if int(when) > int(seen or 0):
        out["news"] = {"at": int(when), "title": title, "link": link}
print(json.dumps(out))
' "$pending" "$plan" "$RESTART_PATTERN" "$state" "$waiting" "$downloaded" "$news" "$seen" "$(now)" "$VALID_SECONDS" "$verified" >"$BASE/.state.new"
  mv -f "$BASE/.state.new" "$STATE"
  cat "$STATE"
}

RUN_EVENTS="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-auto-update/run.jsonl"

status() {
  local s='{"state":"unknown","packages":[],"count":0}'
  [[ -f $STATE ]] && s=$(cat "$STATE")
  # The saved state belongs to the normal system; a restore point being tried
  # offers nothing.
  local current
  current=$(booted_snapshot)
  if [[ -n $current ]]; then
    mark_reached "$current"
    # Our try: "attention" keeps the bar icon up in every icon mode, the way to
    # decide whenever the user is ready to. A restore point started from the
    # boot menu is Omarchy's own to restore; there is nothing to decide here.
    if [[ $(jq -r '.snapshot // empty' "$ROLLBACK" 2>/dev/null) == "$current" ]]; then
      jq -cn '{state: "attention", reason: "trying", message: "Trying the version from before the update. Open to decide", packages: [], count: 0}'
    else
      jq -cn '{state: "uptodate", reason: "snapshot", message: "Running from a restore point. Updates wait for the normal system", packages: [], count: 0}'
    fi
    return 0
  fi
  # An update started from the overlay that the user hasn't dismissed yet. If
  # its process is gone without saying it finished, record that it stopped.
  if [[ -f $RUN_EVENTS ]] && ! grep -q '"type": "done"' "$RUN_EVENTS"; then
    local lockf="${RUN_EVENTS%/*}/run.lock"
    if [[ -f $lockf ]] && flock -n "$lockf" true 2>/dev/null; then
      echo '{"type": "done", "ok": false, "error": "The update stopped unexpectedly. Run Omarchy update to finish it."}' >>"$RUN_EVENTS"
    fi
  fi
  [[ -f $RUN_EVENTS ]] && s=$(jq -c '. + {run: true}' <<<"$s" 2>/dev/null || echo "$s")
  s=$(offline_state "$s")
  s=$(held_state "$s")
  # The bar icon setting rides along, so the bar picks it up on its usual reload,
  # and so does the key `notify` uses to tell each set or state only once.
  jq -c --arg mode "$(icon_mode)" "$NOTIFY_KEYS_JQ"' as $keys | . + {iconMode: $mode, notifyKeys: $keys, notifyKey: ($keys | join("|"))}' <<<"$s" 2>/dev/null ||
    echo "$s"
}

# What a notification would be about, one key per thing to tell: a set waiting
# for a restart, a state that needs the user (with its message and set), a new
# set downloaded and ready, and Arch news to read first. Nothing while an update
# runs, since the user started it and the overlay follows it. Keys are one line.
NOTIFY_KEYS_JQ='
  def clean: tostring | gsub("[\\r\\n\\t]"; " ");
  if .run then []
  else
    [ (if .restartPending then "restart:" + (.restartPending.fingerprint // "" | clean) else empty end),
      (if .state == "attention" then "attention:" + ([.reason, .message, .fingerprint] | map(. // "" | clean) | join("/")) else empty end),
      (if .state == "ready" and (.restartPending | not) then "ready:" + (.fingerprint // "" | clean) else empty end),
      (if .news then "news:" + (.news.at // "" | clean) + "/" + (.news.link // "" | clean) else empty end) ]
  end'

# Whether the bar icon shows this status in a given mode. Keep in step with
# BarWidget.qml (showIcon / importantIcon).
SHOWS_JQ='
  if $mode == "hidden" then false
  elif $mode == "always" then true
  elif $mode == "important" then (.run or .restartPending or .state == "attention" or .state == "error" or .news)
  else (.run or .restartPending or .state == "ready" or .state == "attention" or .state == "error" or .news) end'

# What the offline installer left: a set waiting for a restart, and the result
# of the last restart that installed one, until the user has seen it.
offline_state() {
  local s="$1" staged=null applied=null health=null id
  if [[ $(readlink "$TRIGGER" 2>/dev/null) == "$SPOOL/staged" ]]; then
    staged=$(jq -c '{fingerprint, stagedAt, count}' "$SPOOL/staged/omarchy-auto-update.json" 2>/dev/null) || staged=null
  fi
  id=$(jq -r '.id // empty' "$SPOOL/result.json" 2>/dev/null || true)
  if [[ -n $id && $id != "$(cat "$APPLIED_SEEN" 2>/dev/null)" ]]; then
    applied=$(jq -c . "$SPOOL/result.json" 2>/dev/null) || applied=null
    if [[ $(jq -r .id "$HEALTH" 2>/dev/null) == "$id" ]]; then
      health=$(jq -c . "$HEALTH" 2>/dev/null) || health=null
    fi
  fi
  jq -c --argjson staged "${staged:-null}" --argjson applied "${applied:-null}" --argjson health "${health:-null}" \
    '. + {restartPending: $staged, applied: $applied, health: $health}' <<<"$s" 2>/dev/null || echo "$s"
}

failed_units() {
  systemctl "$@" --failed --no-legend --plain 2>/dev/null | awk '{print $1}' | jq -Rsc 'split("\n") | map(select(length > 0))'
}

# Called by the runner right before staging, so the check after the restart
# only counts what broke since.
baseline() {
  mkdir -p "$BASE"
  jq -n --argjson system "$(failed_units)" --argjson user "$(failed_units --user)" \
    '{system: $system, user: $user}' >"$BASE/failed-before.json"
}

# After an update installed on restart: did the session come up whole, and what
# is left to finish. Migrations ship with Omarchy and run as the user, so they
# could not run during the restart; those that call sudo need the password.
after_restart() {
  local id
  id=$(jq -r '.id // empty' "$SPOOL/result.json" 2>/dev/null || true)
  if [[ -z $id || $id == "$(cat "$APPLIED_SEEN" 2>/dev/null)" ]]; then
    echo '{}'
    return
  fi
  local before='{"system": [], "user": []}' hypr=false shell=false
  [[ -f $BASE/failed-before.json ]] && before=$(cat "$BASE/failed-before.json")
  hyprctl version >/dev/null 2>&1 && hypr=true
  pgrep -u "$(id -u)" -x quickshell >/dev/null && shell=true
  local pending needs=false dir="${OMARCHY_PATH:-/usr/share/omarchy}/migrations" m
  pending=$(omarchy-migrate --pending 2>/dev/null || true)
  while IFS= read -r m; do
    [[ -n $m ]] && grep -qw sudo "$dir/$m" 2>/dev/null && needs=true
  done <<<"$pending"
  mkdir -p "$BASE"
  jq -n --arg id "$id" --argjson before "$before" --argjson system "$(failed_units)" \
    --argjson user "$(failed_units --user)" --argjson hypr "$hypr" --argjson shell "$shell" \
    --arg pending "$pending" --argjson needs "$needs" --argjson at "$(now)" '
    ($system - ($before.system // [])) as $newSystem | ($user - ($before.user // [])) as $newUser |
    {id: $id, at: $at, hyprland: $hypr, shell: $shell, failed: ($newSystem + $newUser),
     ok: ($hypr and $shell and ($newSystem + $newUser | length) == 0),
     migrations: ($pending | split("\n") | map(select(length > 0))), needsPassword: $needs}' >"$HEALTH.tmp"
  mv -f "$HEALTH.tmp" "$HEALTH"
  cat "$HEALTH"
}

ack_applied() {
  local id
  id=$(jq -r '.id // empty' "$SPOOL/result.json" 2>/dev/null || true)
  [[ -n $id ]] && { mkdir -p "$BASE"; echo "$id" >"$APPLIED_SEEN"; }
  return 0
}

# The last update installed on restart, seen or not: what the overlay's
# "installed" view shows when the note after it is clicked.
last_applied() {
  local r
  r=$(jq -c 'select(.ok == true or .state == "partial")' "$SPOOL/result.json" 2>/dev/null) || r=""
  [[ -n $r ]] || { echo '{}'; return 0; }
  # Results written before the installer recorded the packages have none; read
  # them from pacman's log, between the start and the end of that install.
  if [[ $(jq -r '.packages | type' <<<"$r") != array ]]; then
    r=$(python3 -I - "$r" /var/log/pacman.log <<'PY' 2>/dev/null || echo "$r"
import json, re, sys
from datetime import datetime
r = json.loads(sys.argv[1])
start, end = r.get("at", 0), r.get("finishedAt", 0) + 2
line_re = re.compile(r"^\[([^\]]+)\] \[ALPM\] (upgraded|installed|downgraded) (\S+) \((.+)\)$")
pkgs = []
with open(sys.argv[2], errors="replace") as f:
    for line in f:
        m = line_re.match(line.rstrip("\n"))
        if not m:
            continue
        try:
            t = datetime.fromisoformat(m.group(1)).timestamp()
        except ValueError:
            continue
        if start <= t <= end:
            old, _, new = m.group(4).rpartition(" -> ")
            pkgs.append({"name": m.group(3), "from": old, "to": new})
if pkgs:
    r["packages"] = pkgs
print(json.dumps(r, separators=(",", ":")))
PY
)
  fi
  echo "$r"
}

# The restore point this boot runs from, from the kernel command line.
booted_snapshot() {
  grep -oE 'subvol=[^ ]*/\.snapshots/[0-9]+/snapshot' "$CMDLINE" 2>/dev/null | grep -oE '[0-9]+' | tail -n 1 || true
}

# Limine's boot entries and its current one, from the Boot Loader Interface.
# Prints JSON: {"entries": [...], "selected": "..."}.
loader_entries() {
  python3 -I - "$EFIVARS" <<'PY' 2>/dev/null || echo '{"entries":[],"selected":""}'
import glob, json, os, sys
GUID = "4a67b082-0a4c-41cf-b6c7-440b29bb8c4f"
def read(name):
    try:
        with open(os.path.join(sys.argv[1], f"{name}-{GUID}"), "rb") as f:
            data = f.read()[4:]  # attributes first
    except OSError:
        return []
    return [e for e in data.decode("utf-16-le", "replace").split("\0") if e]
sel = read("LoaderEntrySelected")
print(json.dumps({"entries": read("LoaderEntries"), "selected": sel[0] if sel else ""}))
PY
}

# Whether the last update installed on restart can be tried without, and how.
rollback_info() {
  local applied current
  # Installed or only partly installed: both left a restore point to go back to.
  applied=$(jq -c 'select(.state == "installed" or .state == "partial")' "$SPOOL/result.json" 2>/dev/null) || applied=""
  [[ -n $applied ]] || applied='{}'
  current=$(booted_snapshot)
  python3 -I - "$applied" "$(loader_entries)" "$current" <<'PY'
import json, re, sys
from datetime import datetime
a, le, current = json.loads(sys.argv[1]), json.loads(sys.argv[2]), sys.argv[3]
out = {"available": False, "count": a.get("count", 0), "at": a.get("at", 0)}
n = (a.get("snapshots") or {}).get("root")
safe = re.compile(r"^[A-Za-z0-9._-]+$")
def why(reason):
    out["reason"] = reason
    print(json.dumps(out))
    sys.exit(0)
if current:
    why("in-snapshot")
if not isinstance(n, int) or not a.get("bootMenu"):
    why("no-restore-point")
selected = le.get("selected", "")
# The kernel part of the entry this boot came from ("…linux-omarchy"), so the
# restore point starts the same kind of kernel.
kernel = selected.rsplit(".", 1)[-1] if "." in selected else ""
found = []
for e in le.get("entries", []):
    m = re.search(r"(?:^|\.)Snapshots\.(\d+)-+(\d{4}-\d\d-\d\d-\d\d-\d\d-\d\d)\.", e)
    if not m or int(m.group(1)) != n or not safe.match(e):
        continue
    if kernel and not e.endswith("." + kernel):
        continue
    # Same snapshot as this update's: taken right after it started.
    try:
        taken = datetime.strptime(m.group(2), "%Y-%m-%d-%H-%M-%S").timestamp()
    except ValueError:
        continue
    if abs(taken - a.get("at", 0)) <= 600:
        found.append(e)
if len(found) != 1 or not safe.match(selected):
    why("no-boot-entry")
out.update(available=True, snapshot=n, entry=found[0], normal=selected)
print(json.dumps(out))
PY
}

# Restart once into the restore point; the normal entry stays the default.
try_restore() {
  local info entry
  [[ -z $(booted_snapshot) ]] || die "already running from a restore point"
  info=$(rollback_info)
  [[ $(jq -r .available <<<"$info") == true ]] || die "no restore point to try ($(jq -r '.reason // "unknown"' <<<"$info"))"
  entry=$(jq -r .entry <<<"$info")
  mkdir -p "$(dirname "$ROLLBACK")"
  # A try already armed in this boot (its restart failed): the one-time entry is
  # still set, so its record must outlive a cancelled second attempt.
  local boot armed=false
  boot=$(cat /proc/sys/kernel/random/boot_id)
  if [[ -f $ROLLBACK ]] && jq -e --arg b "$boot" '.armed == true and .fromBoot == $b' "$ROLLBACK" >/dev/null 2>&1; then
    armed=true
  fi
  # Ours to remove later only if absent now or added by an earlier try.
  local hid=false
  if [[ ! -e $RESTORE_NOTE ]] || grep -q "Added by $PLUGIN_ID" "$RESTORE_NOTE" 2>/dev/null; then
    hid=true
  fi
  # The try is written before anything else changes, so a later boot can always
  # undo it; nothing restarts unless it was saved.
  # What the restore point lacks, for the view in it.
  local packages
  packages=$(last_applied | jq -c '.packages // []' 2>/dev/null) || packages='[]'
  if ! jq -n --argjson info "$info" --argjson at "$(now)" --arg boot "$boot" --argjson armed "$armed" \
    --argjson hid "$hid" --argjson packages "$packages" \
    '$info + {phase: "requested", requestedAt: $at, fromBoot: $boot, hidNote: $hid, armed: $armed, packages: $packages}' >"$ROLLBACK.tmp" ||
    ! mv -f "$ROLLBACK.tmp" "$ROLLBACK"; then
    rm -f "$ROLLBACK.tmp"
    die "couldn't save the try"
  fi
  if [[ $hid == true ]] && ! {
    mkdir -p "$(dirname "$RESTORE_NOTE")" &&
      printf '[Desktop Entry]\nHidden=true\n# Added by %s for one restore-point try; removed after it.\n' "$PLUGIN_ID" >"$RESTORE_NOTE"
  }; then
    end_try
    die "couldn't prepare the restore point"
  fi
  if ! "$PKEXEC" "$BOOTCTL" set-oneshot "$entry"; then
    [[ $armed == true ]] || end_try
    die "the restart into the restore point wasn't confirmed"
  fi
  jq '.armed = true' "$ROLLBACK" >"$ROLLBACK.tmp" && mv -f "$ROLLBACK.tmp" "$ROLLBACK"
  # The one-time entry is set now: the try stays recorded even if this restart
  # fails, so whichever boot comes next knows what it is.
  "$SYSTEMCTL" reboot || die "couldn't restart; the restore point opens at the next restart"
}

# Undo what a try changed outside the restore point.
end_try() {
  if [[ -f $ROLLBACK && $(jq -r '.hidNote // false' "$ROLLBACK" 2>/dev/null) == true ]] &&
    grep -q "Added by $PLUGIN_ID" "$RESTORE_NOTE" 2>/dev/null; then
    rm -f "$RESTORE_NOTE"
  fi
  rm -f "$ROLLBACK" "$ROLLBACK.tmp"
}

# This boot and a try in progress. In a restore point: {inSnapshot: N, ours,
# ...the try}. Back in the normal system the try ends here; "missed" says the
# restart didn't reach the restore point.
# Reached: from here on, the next normal boot is not a missed try. Called from
# status too, which the shell runs as soon as it starts.
mark_reached() {
  local current="$1" try
  [[ -f $ROLLBACK ]] || return 0
  try=$(jq -c . "$ROLLBACK" 2>/dev/null) || return 0
  if [[ $(jq -r '.phase // empty' <<<"$try") == requested && $(jq -r '.snapshot // empty' <<<"$try") == "$current" ]]; then
    jq -c '.phase = "trying"' <<<"$try" >"$ROLLBACK.tmp" && mv -f "$ROLLBACK.tmp" "$ROLLBACK"
  fi
  return 0
}

snapshot_state() {
  local current try='{}'
  current=$(booted_snapshot)
  if [[ -n $current ]]; then
    mark_reached "$current"
    [[ -f $ROLLBACK ]] && try=$(jq -c . "$ROLLBACK" 2>/dev/null || echo '{}')
    jq -c --argjson n "$current" '. + {inSnapshot: $n, ours: (.snapshot == $n)}' <<<"$try"
    return 0
  fi
  [[ -f $ROLLBACK ]] && try=$(jq -c . "$ROLLBACK" 2>/dev/null || echo '{}')
  local phase missed=false kept=null
  phase=$(jq -r '.phase // empty' <<<"$try")
  if [[ $phase == requested && $(jq -r '.fromBoot // empty' <<<"$try") != "$(cat /proc/sys/kernel/random/boot_id)" ]]; then
    missed=true
  fi
  # Kept for good: the first normal boot after it says so, once.
  [[ $phase == kept ]] && kept=$(jq -c '{at, count, keptAt}' <<<"$try")
  [[ -n $phase && $(jq -r '.fromBoot // empty' <<<"$try") != "$(cat /proc/sys/kernel/random/boot_id)" ]] && end_try
  jq -cn --argjson missed "$missed" --argjson kept "$kept" '{inSnapshot: null, missed: $missed, kept: $kept}'
}

# Keep the restore point being tried: Limine's restore makes it the system
# (the updated one is kept as a restore point of its own, in the boot menu),
# then a plain restart starts it. The update is held back afterwards.
keep_restore() {
  local current try
  current=$(booted_snapshot)
  [[ -n $current ]] || die "not running from a restore point"
  try=$(jq -c . "$ROLLBACK" 2>/dev/null) || die "this restore point wasn't started by Auto Update"
  [[ $(jq -r '.snapshot // empty' <<<"$try") == "$current" ]] || die "this restore point wasn't started by Auto Update"
  mkdir -p "$BASE"
  # The records the restored system needs are written first: if they can't be,
  # nothing is restored. They take effect by a rename once it is done.
  if ! jq -c '{at: (now | floor), from: .at, packages: (.packages // [])}' <<<"$try" >"$HELD.next" ||
    ! jq -c --argjson t "$(now)" '.phase = "kept" | .keptAt = $t' <<<"$try" >"$ROLLBACK.next"; then
    rm -f "$HELD.next" "$ROLLBACK.next"
    die "couldn't save what to hold back; nothing changed"
  fi
  # Its answers come only for this restore point's number; anything else it asks
  # is cancelled, and the restore happens only after the password.
  if ! python3 -I - "$current" "$RESTORE_LOG" "$PKEXEC" "$SCRIPT" "$LSS" <<'PY'; then
import os, re, select, subprocess, sys, time
want, log_path, pkexec, script, lss = sys.argv[1:6]
cmd = [pkexec, script, "-qefc", "env LC_ALL=C.UTF-8 LANG=C.UTF-8 " + lss + " --restore --no-mutex", "/dev/null"]
ansi = re.compile(rb"\x1b\[[0-9;?]*[A-Za-z]")
log = open(log_path, "wb")
p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
fd, pending, seen = p.stdout.fileno(), b"", b""
started = done = cancelled = False
asked = set()
closed = False
last = time.time()
def answer(text):
    if closed:
        return
    try:
        p.stdin.write(text); p.stdin.flush()
    except OSError:
        pass
while True:
    ready, _, _ = select.select([fd], [], [], 1)
    if ready:
        data = os.read(fd, 4096)
        if not data:
            break
        log.write(data); log.flush(); last = time.time()
        pending += data
        text = ansi.sub(b"", pending).replace(b"\r", b"")
        seen = (seen + text)[-4000:]
        if b"Mounting Btrfs" in text:
            started = True
        if b"Restore complete" in text:
            done = True
        # The line editor redraws a prompt as it is answered: each is answered once.
        kind = (b"restore" if re.search(rb"Choice \[r/l/c\]: $", text)
                else b"describe" if re.search(rb"Description for backup subvolume[^\n]*: $", text)
                else b"reboot" if re.search(rb"Reboot now\? \[Y/n\]: $", text)
                else b"exit" if re.search(rb"Press Enter to exit: $", text)
                else b"other:" + text.rsplit(b"\n", 1)[-1] if re.search(rb"(Choice \[[a-z/]+\]|\[[Yy]/[Nn]\]): $", text) else None)
        if kind and kind not in asked:
            asked.add(kind); pending = b""
            if kind == b"restore":
                m = re.findall(rb"Restore snapshot (\d+) ", seen)
                if m and m[-1].decode() == want:
                    answer(b"r\n")
                else:
                    cancelled = True; answer(b"c\n")
            elif kind == b"describe":
                answer(b"The updated version, kept by Auto Update\n")
            elif kind == b"reboot":
                answer(b"n\n")
            elif kind == b"exit":
                answer(b"\n")
            else:
                # A question we don't know: say no. Before the restore started
                # that cancels it; after, it is a hook's, and the restore goes on.
                cancelled = cancelled or not started
                answer(b"c\n" if b"Choice" in text else b"n\n")
    elif not closed and time.time() - last > (120 if not started else 600):
        # Silent at a question we don't know. It runs as root, so it can only be
        # told end of input; it is watched until it really ends either way.
        cancelled = cancelled or not started
        closed = True
        try:
            p.stdin.close()
        except OSError:
            pass
code = p.wait()
log.close()
if done and code == 0 and not (cancelled and not started):
    sys.exit(0)
if code in (126, 127) and not started:
    print("the password wasn't given", file=sys.stderr)
elif started:
    print("the restore didn't finish; see " + log_path, file=sys.stderr)
else:
    print("the restore was cancelled; nothing changed", file=sys.stderr)
sys.exit(1)
PY
    rm -f "$HELD.next" "$ROLLBACK.next"
    die "couldn't keep the restore point"
  fi
  # From here the restore point is the system. Hold the update back and say so
  # after the restart; both live in the home subvolume the restore didn't touch.
  # Without its records the restart waits for the user, who is told why.
  mv -f "$HELD.next" "$HELD" 2>/dev/null || die "kept; couldn't hold the update back, so it is offered again. Restart to start this version"
  mv -f "$ROLLBACK.next" "$ROLLBACK" 2>/dev/null || die "kept; couldn't record it. Restart to start this version"
  "$SYSTEMCTL" reboot || die "kept; restart to start it"
}

# The update the user went back from stays out of the way while the same set is
# all there is. A set with anything newer is offered as usual and ends the hold.
held_state() {
  local s="$1" out
  [[ -f $HELD ]] || { echo "$s"; return 0; }
  out=$(jq -c --slurpfile h "$HELD" '
    def key: (.name // "") + " " + (.to // "");
    ($h[0].packages // [] | map(key)) as $held
    | if .state == "ready" and (.packages // [] | length) > 0 then
        if all(.packages[]; key as $k | any($held[]; . == $k)) and ($held | length) > 0
        then . + {state: "held", reason: "held", message: "On hold: you went back from these updates", heldAt: $h[0].at}
        else . + {heldEnded: true} end
      else . end' <<<"$s" 2>/dev/null) || { echo "$s"; return 0; }
  if [[ $(jq -r '.heldEnded // false' <<<"$out") == true ]]; then
    rm -f "$HELD"
    out=$(jq -c 'del(.heldEnded)' <<<"$out")
  fi
  echo "$out"
}

install_again() {
  rm -f "$HELD"
  run --force
}

# From a restore point back to the normal system. Omarchy's Limine menu starts
# its default entry, the normal system, so a plain restart is enough. Where it
# remembers the last entry instead, that restart comes back here: the second
# time, the normal entry is chosen by name (with the password).
return_updated() {
  local normal entries phase boot
  [[ -n $(booted_snapshot) ]] || die "not running from a restore point"
  boot=$(cat /proc/sys/kernel/random/boot_id)
  # Came back here after a return from an earlier boot; a second press in the
  # same boot (its restart didn't happen) still restarts plainly.
  phase=$(jq -r --arg b "$boot" 'if .phase == "returning" and .returnFrom != $b then "returned" else "" end' "$ROLLBACK" 2>/dev/null || true)
  if [[ -f $ROLLBACK ]]; then
    jq --arg boot "$boot" '.phase = "returning" | .returnFrom = $boot' "$ROLLBACK" >"$ROLLBACK.tmp" &&
      mv -f "$ROLLBACK.tmp" "$ROLLBACK"
  fi
  if [[ $phase != returned ]]; then
    "$SYSTEMCTL" reboot
    return
  fi
  normal=$(jq -r '.normal // empty' "$ROLLBACK" 2>/dev/null || true)
  entries=$(loader_entries)
  # Without a remembered one that still exists, the only entry outside Snapshots.
  if ! [[ $normal =~ ^[A-Za-z0-9._-]+$ ]] || ! jq -e --arg n "$normal" '.entries | index($n)' <<<"$entries" >/dev/null; then
    normal=$(jq -r '[.entries[] | select(test("(^|\\.)Snapshots\\.") | not) | select(test("^[A-Za-z0-9._-]+$"))]
      | if length == 1 then .[0] else empty end' <<<"$entries")
  fi
  [[ -n $normal ]] || die "couldn't find the normal boot entry; restart and pick it in the boot menu"
  "$PKEXEC" "$BOOTCTL" set-oneshot "$normal" || die "the restart wasn't confirmed"
  "$SYSTEMCTL" reboot
}

ack_news() {
  local news tmp
  news=$(latest_news)
  [[ -n $news ]] || return 0
  mkdir -p "$BASE"
  exec 9>"$LOCK"
  flock -w 30 9 || die "a check is running; try again"
  cut -f1 <<<"$news" >"$NEWS_SEEN"
  if [[ -f $STATE ]]; then
    tmp=$(mktemp "$BASE/.state.XXXXXX")
    jq 'del(.news)' "$STATE" >"$tmp" && mv -f "$tmp" "$STATE"
  fi
  status
}

# Called when the user dismisses a finished update in the overlay.
ack_run() {
  [[ -f $RUN_EVENTS ]] && mv -f "$RUN_EVENTS" "$RUN_EVENTS.seen"
  return 0
}

update_now() {
  local launcher=omarchy-launch-floating-terminal-with-presentation
  command -v "$launcher" >/dev/null || launcher="${OMARCHY_PATH:-/usr/share/omarchy}/bin/$launcher"
  setsid -f "$launcher" omarchy-update >/dev/null 2>&1 </dev/null
}

# ---------------------------------------------------------------- settings

ICON_MODES="always updates important hidden"

valid_icon_mode() {
  case "${1:-}" in
    always | updates | important | hidden) return 0 ;;
    *) return 1 ;;
  esac
}

icon_mode() {
  local m
  m=$(jq -r 'if (.iconMode | type) == "string" then .iconMode else empty end' "$CONFIG" 2>/dev/null || true)
  # "shown" was the name of "updates" before there were four choices.
  [[ $m == shown ]] && m=updates
  valid_icon_mode "$m" && echo "$m" || echo updates
}

config_get() {
  jq -cn --arg iconMode "$(icon_mode)" '{iconMode: $iconMode}'
}

config_set() {
  local key="${1:-}" value="${2:-}" base='{}' tmp
  case $key in
    icon-mode) valid_icon_mode "$value" || die "icon-mode must be one of: $ICON_MODES" ;;
    *) die "unknown setting: ${key:-none} (known: icon-mode)" ;;
  esac
  mkdir -p "$CONFIG_DIR"
  exec 7>"$CONFIG_DIR/.lock"
  flock -w 10 7 || die "settings are being changed; try again"
  # Settings this version doesn't know are kept; a file that isn't an object is replaced.
  jq -e 'type == "object"' "$CONFIG" >/dev/null 2>&1 && base=$(cat "$CONFIG")
  tmp=$(mktemp "$CONFIG_DIR/.config.XXXXXX")
  if ! jq --arg v "$value" '.iconMode = $v' <<<"$base" >"$tmp" || ! mv -f "$tmp" "$CONFIG"; then
    rm -f "$tmp"
    die "couldn't write $CONFIG"
  fi
  config_get
}

config() {
  case "${1:-}" in
    get) config_get ;;
    set) shift; config_set "$@" ;;
    *) die "usage: config get | config set icon-mode <${ICON_MODES// /|}>" ;;
  esac
}

# ---------------------------------------------------------------- notifications

# Keys already told (or already shown by the icon), newest last. A short history
# rather than one key, so ready:A → attention → ready:A doesn't tell A twice.
NOTIFIED_KEEP=20
# Notifications handed to notify-wait but not confirmed yet, one file per
# request holding "epoch<TAB>keys"; each waiter clears only its own.
NOTIFY_PENDING="$BASE/notify-pending.d"
NOTIFY_PENDING_SECONDS=60

seen_key() { [[ -f $NOTIFIED ]] && grep -Fxq -- "$1" "$NOTIFIED"; }

# Appends keys (one per line on stdin) to the history, keeping the last few.
# Callers hold notify.lock.
remember_keys() {
  local tmp
  mkdir -p "$BASE"
  tmp=$(mktemp "$BASE/.notified.XXXXXX")
  { cat "$NOTIFIED" 2>/dev/null; cat; } | awk 'NF && !seen[$0]++' | tail -n "$NOTIFIED_KEEP" >"$tmp" &&
    mv -f "$tmp" "$NOTIFIED" || rm -f "$tmp"
}

notify_lock() {
  mkdir -p "$BASE"
  exec 8>"$BASE/notify.lock"
  flock -w 10 8
}

# Called by the bar whenever status.notifyKey changes. Tells the user once per
# key, and only when the bar icon doesn't show it in the current mode. Keys are
# remembered on disk only once the notification was handed to the notification
# service, so a failed delivery is tried again on the next change or start.
notify() {
  notify_lock || return 0
  local s keys=() k fresh=() pending="" at list f
  s=$(status)
  while IFS= read -r k; do [[ -n $k ]] && keys+=("$k"); done < <(jq -r '.notifyKeys // [] | .[]' <<<"$s")
  ((${#keys[@]})) || return 0
  mkdir -p "$NOTIFY_PENDING"
  for f in "$NOTIFY_PENDING"/*; do
    [[ -f $f ]] || continue
    IFS=$'\t' read -r at list <"$f" || true
    [[ $at =~ ^[0-9]+$ ]] || at=0
    # A waiter that never confirmed (killed with the session) stops blocking.
    if (($(now) - at < NOTIFY_PENDING_SECONDS)); then pending+=$'\x1f'$list; else rm -f "$f"; fi
  done
  for k in "${keys[@]}"; do
    seen_key "$k" && continue
    [[ $'\x1f'$pending$'\x1f' == *$'\x1f'"$k"$'\x1f'* ]] && continue
    fresh+=("$k")
  done
  ((${#fresh[@]})) || return 0
  # Seen in the bar: nothing to send, but don't tell it later either.
  if [[ $(jq -r --arg mode "$(icon_mode)" "$SHOWS_JQ" <<<"$s") != false ]]; then
    printf '%s\n' "${fresh[@]}" | remember_keys
    return 0
  fi
  local text title body
  text='
    # Every key this notification records must be in its text, news included.
    (if .news then " Arch news to read first: " + .news.title + "." else "" end) as $news |
    if .restartPending then ["Updates will install when you restart", "Click to see them, or restart when it suits you." + $news]
    elif .state == "attention" then ["Updates need your attention", (.message // "Click to see why.") + $news]
    elif .state == "ready" then
      [(if .tier == "major" then "A new version of Omarchy is ready"
        else ((.count | tostring) + (if .count == 1 then " update" else " updates" end) + " ready"
              + (if .tier == "restart" then " · restart to finish" else "" end)) end),
       (if .news then "Arch news to read first: " + .news.title + ". Click to review the updates."
        else "Downloaded and checked in the background. Click to review them." end)]
    else ["Arch news to read before updating", ((.news.title // "") + ". Click to open Auto Update.")] end'
  title=$(jq -r "$text | .[0]" <<<"$s")
  body=$(jq -r "$text | .[1]" <<<"$s")
  local req
  list=$(IFS=$'\x1f'; echo "${fresh[*]}")
  req=$(mktemp "$NOTIFY_PENDING/XXXXXX")
  printf '%s\t%s\n' "$(now)" "$list" >"$req"
  # notify-send waits for the click; that part runs on its own, without this
  # lock (fd 8), so the next notify never waits behind an open notification.
  setsid -f "$SELF" notify-wait "$req" "$list" "$title" "$body" >/dev/null 2>&1 </dev/null 8>&-
}

# Internal: sends the notification, remembers its keys once the service took
# it (notify-send prints the id first), and opens the overlay on a click.
notify_wait() {
  local req="${1:-}" list="${2:-}" title="${3:-}" body="${4:-}" line sent=false action=""
  exec 8>&-
  while IFS= read -r line; do
    # notify-send prints id 0 when the service refused or wasn't there.
    if [[ $sent == false && $line =~ ^[0-9]+$ ]]; then
      ((10#$line > 0)) && sent=true
      notify_confirm "$req" "$list" "$sent"
      [[ $sent == true ]] || break
    elif [[ -n $line ]]; then
      action=$line
    fi
  done < <(notify-send -p -a "Auto Update" -i system-software-update -A "default=Open" -- "$title" "$body" 2>/dev/null)
  [[ $sent == true ]] || notify_confirm "$req" "$list" false
  [[ $action == default ]] && omarchy-shell shell summon "$PLUGIN_ID" "{}" >/dev/null 2>&1
  return 0
}

# Clears this request's pending note; on success its keys join the history.
notify_confirm() {
  (
    notify_lock || exit 0
    [[ $3 == true ]] && tr $'\x1f' '\n' <<<"$2" | remember_keys
    [[ $1 == "$NOTIFY_PENDING"/* ]] && rm -f "$1"
  )
}

# ---------------------------------------------------------------- menu entry
#
# Like the other ai-dico plugins, this owns one marked block in the user's menu
# extension file and never touches the rest. A file whose markers are unbalanced
# or out of order is left alone.

# Prints none | ok | broken.
block_state() {
  awk -v b="$2" -v e="$3" '
    $0 == b { nb++; if (open) bad = 1; open = 1 }
    $0 == e { ne++; if (!open) bad = 1; open = 0 }
    END {
      if (nb == 0 && ne == 0) print "none"
      else if (nb == 1 && ne == 1 && !bad && !open) print "ok"
      else print "broken"
    }' "$1"
}

file_hash() { [[ -f $1 ]] && sha256sum <"$1" | cut -d' ' -f1 || echo none; }

# True when $1 parses the way Omarchy's menu reads it (MenuModel.stripJsonc:
# drop whole-line // comments and trailing commas, then JSON.parse).
menu_parses() {
  python3 -I -c '
import json, re, sys
raw = open(sys.argv[1], encoding="utf-8").read()
raw = re.sub(r"^\s*//[^\n]*(\n|$)", "", raw, flags=re.M)
raw = re.sub(r",(\s*[}\]])", r"\1", raw)
sys.exit(0 if isinstance(json.loads(raw), dict) else 1)
' "$1" 2>/dev/null
}

# Writes stdin over $1 via a temp file in the same directory (follows symlinks),
# but only if the result still parses as a menu and $1 still has hash $2 (the
# content the new text was made from). Otherwise $1 is left as it is.
#
# Other programs don't take our lock, so the swap is an atomic exchange: what
# comes back is exactly what was there at that moment. If someone wrote after
# the check, their version goes straight back and we try again another time.
# Left open: a write landing in the instant between the two exchanges.
replace_file() {
  local target tmp
  target=$(readlink -f "$1")
  tmp=$(mktemp "$(dirname "$target")/.omarchy-auto-update.XXXXXX") || return 1
  cat >"$tmp" || { rm -f "$tmp"; return 1; }
  if ! menu_parses "$tmp"; then
    rm -f "$tmp"
    echo "omarchy-auto-update: the menu file would not parse after the change; left as it was" >&2
    return 1
  fi
  # Tests: another writer edits the file in between.
  [[ ${OMARCHY_AUTO_UPDATE_TEST:-} == 1 && -n ${OMARCHY_AUTO_UPDATE_TEST_MENU_RACE:-} ]] &&
    printf '%s\n' "$OMARCHY_AUTO_UPDATE_TEST_MENU_RACE" >>"$target"
  if [[ $(file_hash "$target") != "$2" ]]; then
    rm -f "$tmp"
    echo "omarchy-auto-update: $1 changed while it was being updated; will try again later" >&2
    return 1
  fi
  chmod --reference="$target" "$tmp" 2>/dev/null || true
  # Tests: another writer edits the file after the check.
  [[ ${OMARCHY_AUTO_UPDATE_TEST:-} == 1 && -n ${OMARCHY_AUTO_UPDATE_TEST_MENU_RACE_LATE:-} ]] &&
    printf '%s\n' "$OMARCHY_AUTO_UPDATE_TEST_MENU_RACE_LATE" >>"$target"
  local ours
  ours=$(file_hash "$tmp")
  if ! mv --exchange -- "$tmp" "$target" 2>/dev/null; then
    # No atomic exchange here (old coreutils or filesystem). A plain rename
    # could drop someone else's edit, so leave the menu alone.
    rm -f "$tmp"
    echo "omarchy-auto-update: can't swap $1 safely here; left it as it was" >&2
    return 1
  fi
  if [[ $(file_hash "$tmp") != "$2" ]]; then
    # $tmp now holds the other writer's version. Put it back; if that fails,
    # keep it where it is so nothing they wrote is lost.
    if mv --exchange -- "$tmp" "$target" 2>/dev/null; then
      # What comes out should be our text; anything else is a newer edit.
      if [[ $(file_hash "$tmp") == "$ours" ]]; then
        rm -f "$tmp"
      else
        echo "omarchy-auto-update: $1 was edited again meanwhile; that version is in $tmp" >&2
      fi
      echo "omarchy-auto-update: $1 changed while it was being updated; will try again later" >&2
    else
      echo "omarchy-auto-update: $1 changed while it was being updated and could not be put back; the other version is in $tmp" >&2
    fi
    return 1
  fi
  rm -f "$tmp"
}

# Prints $1 without the managed block.
without_block() {
  awk -v b="$2" -v e="$3" '$0 == b {skip=1} !skip {print} $0 == e {skip=0}' "$1"
}

# Prints just the managed block of $1.
only_block() {
  awk -v b="$2" -v e="$3" '$0 == b {keep=1} keep {print} $0 == e {keep=0}' "$1"
}

check_block() {
  local state
  state=$(block_state "$1" "$2" "$3")
  if [[ $state == broken ]]; then
    echo "omarchy-auto-update: $1 has a damaged omarchy-auto-update block; fix or remove it by hand" >&2
    return 1
  fi
}

# Update › Auto Update opens the overlay. The row hides itself once this helper
# is gone, so removing the plugin never leaves a dead entry behind.
menu_block() {
  local entry
  entry=$(jq -cn --arg action "$SUMMON" --arg when "test -x $(printf %q "$SELF")" \
    '{icon: "󱓞", label: "Auto Update", description: "Updates prepared in the background", when: $when, action: $action}')
  printf '%s\n  "update.auto-update": %s,\n%s\n' "$MENU_BEGIN" "$entry" "$MENU_END"
}

# The block goes right after the opening brace of the top-level object. Its
# entry ends in a comma, which the menu's JSONC parser accepts, so the file stays
# valid whatever follows. Nothing is written when the block is already current.
write_menu_block() {
  mkdir -p "$(dirname "$MENU_EXT")"
  [[ -f $MENU_EXT ]] || printf '{\n}\n' >"$MENU_EXT"
  check_block "$MENU_EXT" "$MENU_BEGIN" "$MENU_END" || return 1
  [[ $(only_block "$MENU_EXT" "$MENU_BEGIN" "$MENU_END") == "$(menu_block)" ]] && return 0
  local stripped hash
  hash=$(file_hash "$MENU_EXT")
  stripped=$(without_block "$MENU_EXT" "$MENU_BEGIN" "$MENU_END"; echo x)
  stripped=${stripped%x}
  if ! awk '/^[[:space:]]*$/ || /^[[:space:]]*\/\// { next } { exit !/^[[:space:]]*\{[[:space:]]*$/ }' <<<"$stripped"; then
    echo "omarchy-auto-update: $MENU_EXT does not start with a line holding just '{'; menu entry not added" >&2
    return 1
  fi
  # The block goes in through the environment: `awk -v` would unescape the
  # backslashes of its JSON.
  OMU_BLOCK="$(menu_block)" awk '
    !done && /^[[:space:]]*\{[[:space:]]*$/ { print; print ENVIRON["OMU_BLOCK"]; done = 1; next }
    { print }' <<<"${stripped%$'\n'}" | replace_file "$MENU_EXT" "$hash"
}

# `--auto` is what the bar runs at every start: it adds the entry the first
# time and keeps it current after updates, but once the user has taken it out
# (by hand or with menu-remove) it stays out until menu-install is run again.
menu_install() {
  local auto="${1:-}"
  mkdir -p "$BASE"
  exec 7>"$BASE/menu.lock"
  flock -w 10 7 || die "the menu entry is being changed; try again"
  if [[ $auto == --auto && -f $MENU_MARK ]] &&
    { [[ ! -f $MENU_EXT ]] || [[ $(block_state "$MENU_EXT" "$MENU_BEGIN" "$MENU_END") == none ]]; }; then
    return 0
  fi
  write_menu_block || return 1
  date -Is >"$MENU_MARK"
}

menu_remove() {
  mkdir -p "$BASE"
  exec 7>"$BASE/menu.lock"
  flock -w 10 7 || die "the menu entry is being changed; try again"
  [[ -f $MENU_EXT ]] || return 0
  [[ $(block_state "$MENU_EXT" "$MENU_BEGIN" "$MENU_END") == none ]] && return 0
  check_block "$MENU_EXT" "$MENU_BEGIN" "$MENU_END" || return 1
  local hash
  hash=$(file_hash "$MENU_EXT")
  without_block "$MENU_EXT" "$MENU_BEGIN" "$MENU_END" | replace_file "$MENU_EXT" "$hash"
}

cmd="${1:-}"
shift || true
case "$cmd" in
  run) run "${1:-}" ;;
  status) status ;;
  ack-news) ack_news ;;
  ack-run) ack_run ;;
  after-restart) after_restart ;;
  ack-applied) ack_applied ;;
  last-applied) last_applied ;;
  baseline) baseline ;;
  update-now) update_now ;;
  config) config "$@" ;;
  notify) notify ;;
  notify-wait) notify_wait "$@" ;; # internal, started detached by notify
  menu-install) menu_install "${1:-}" ;;
  menu-remove) menu_remove ;;
  rollback-info) rollback_info ;;
  try-restore) try_restore ;;
  snapshot-state) snapshot_state ;;
  return-updated) return_updated ;;
  keep-restore) keep_restore ;;
  install-again) install_again ;;
  -h | --help | help | "") awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0" ;;
  *) die "unknown command: $cmd (see --help)" ;;
esac
