#!/usr/bin/env python3
"""Run Omarchy's own updater without a terminal on screen.

  omarchy-auto-update-runner <expected-count> <expected-tier>

1. In the foreground, talking to the overlay over stdin/stdout:
   {"type": "password", "retry": false}   → the overlay writes the password line
   {"type": "changed"}                    → the pending set changed since the user
                                            agreed; nothing was run
   {"type": "detached", "events": path}   → the update now runs on its own
2. Detached from the shell (Omarchy's updater restarts the shell near the end),
   it runs `omarchy update -y` — Omarchy's unattended mode, which asks nothing —
   in a hidden pseudo-terminal and appends JSON events to `path`:
   {"type": "phase", "id": ..., "label": ...}
   {"type": "progress", "done": 3, "total": 9, "label": "Installing jq"}
   {"type": "log", "line": "..."}
   {"type": "done", "ok": true, "restart": true, "snapshot": true, "log": "..."}

The password is typed only into prompts shown while a privileged sudo process
(effective UID 0) owns the terminal, so no other program can collect it. It is
masked out of the log, kept in memory for this run only, and the process is
made non-dumpable. Which step is running is read from the live process tree.
"""
import ctypes, fcntl, json, os, pty, re, resource, select, signal, subprocess, sys, time

TEST = os.environ.get("OMARCHY_AUTO_UPDATE_TEST") == "1"  # tests: fake sudo check
HERE = os.path.dirname(os.path.realpath(__file__))
HELPER = os.path.join(HERE, "omarchy-auto-update")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "omarchy-auto-update")
RUNTIME = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "omarchy-auto-update")
EVENTS = os.path.join(RUNTIME, "run.jsonl")
PIDFILE = os.path.join(RUNTIME, "run.pid")
LOG = os.path.join(CACHE, "last-update.log")

# Steps of omarchy-update, by the command that runs them. Unknown steps keep the
# previous label, so a new upstream step never shows something wrong.
PHASES = [
    ("omarchy-update-requires-free-space", "space", "Checking free space"),
    ("omarchy-update-pkg-prune", "prepare", "Getting ready"),
    ("omarchy-snapshot", "snapshot", "Saving a restore point"),
    ("omarchy-update-dev", "prepare", "Getting ready"),
    ("omarchy-update-keyring", "prepare", "Getting ready"),
    ("omarchy-update-system-pkgs", "install", "Installing updates"),
    ("omarchy-migrate", "settings", "Updating your settings"),
    ("omarchy-hook", "finish", "Finishing up"),
    ("omarchy-update-aur-pkgs", "extras", "Updating extra apps"),
    ("omarchy-update-mise", "extras", "Updating developer tools"),
    ("omarchy-update-orphan-pkgs", "cleanup", "Cleaning up"),
    ("omarchy-update-analyze-logs", "cleanup", "Checking for problems"),
    ("omarchy-update-restart", "done", "Almost done"),
]
AFTER_SNAPSHOT = {"install", "settings", "finish", "extras", "cleanup", "done"}
PROMPT = re.compile(rb"(\[sudo\] password for [^:\r\n]*|Password):\s*$")
PACMAN_STEP = re.compile(r"\(\s*(\d+)/(\d+)\)\s+(installing|upgrading|reinstalling|removing|downgrading)\s+(\S+)")
ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|\x1b\][^\x07]*\x07|\r")


def harden():
    """No core dumps and no ptrace from other processes of this user."""
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    try:
        ctypes.CDLL(None, use_errno=True).prctl(4, 0, 0, 0, 0)  # PR_SET_DUMPABLE = 0
    except Exception:
        pass


def say(**event):
    sys.stdout.write(json.dumps(event) + "\n")
    sys.stdout.flush()


def state():
    try:
        with open(os.path.join(CACHE, "state.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def check_password(password):
    if TEST:
        return password == "test"
    p = subprocess.run(["sudo", "-S", "-p", "", "-k", "true"], input=password + "\n",
                       capture_output=True, text=True)
    return p.returncode == 0


def proc_stat(pid):
    """(name, pgrp, tty_nr) from /proc/<pid>/stat."""
    with open(f"/proc/{pid}/stat") as f:
        raw = f.read()
    name = raw[raw.index("(") + 1:raw.rindex(")")]
    fields = raw.rsplit(")", 1)[1].split()
    return name, int(fields[2]), int(fields[4])


def privileged_sudo_owns(fd, tty_nr):
    """True when a sudo process running with effective UID 0 is in the
    terminal's foreground process group. A sudo started from a script shares
    the script's group, so every member is checked, not just the leader. An
    ordinary program cannot fake an effective UID of 0, so this tells the real
    sudo prompt from imitations."""
    if TEST and os.environ.get("OMARCHY_AUTO_UPDATE_TEST_TRUST") == "1":
        return True
    try:
        pgid = os.tcgetpgrp(fd)
    except OSError:
        return False
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            name, pgrp, tty = proc_stat(entry)
            if pgrp != pgid or tty != tty_nr or name != "sudo":
                continue
            with open(f"/proc/{entry}/status") as f:
                euid = int(re.search(r"^Uid:\s*\d+\s+(\d+)", f.read(), re.M).group(1))
            if euid == 0:
                return True
        except (OSError, AttributeError, ValueError):
            continue
    return False


def fingerprint(st):
    return str(st.get("fingerprint") or "")


def descendants(pid):
    children = {}
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            with open(f"/proc/{entry}/stat") as f:
                ppid = int(f.read().rsplit(")", 1)[1].split()[1])
            with open(f"/proc/{entry}/cmdline", "rb") as f:
                argv = [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
        except (OSError, ValueError, IndexError):
            continue
        children.setdefault(ppid, []).append((int(entry), argv))
    out, stack = [], [pid]
    while stack:
        for child, argv in children.get(stack.pop(), []):
            out.append(argv)
            stack.append(child)
    return out


def current_phase(pid):
    names = {os.path.basename(a) for argv in descendants(pid) for a in argv[:2]}
    found = None
    for command, pid_, label in PHASES:
        if command in names:
            found = (pid_, label)
    return found


def foreground():
    """Password exchange with the overlay. Returns the password or None."""
    if len(sys.argv) >= 2:
        # Re-plan right before installing: if any package or version changed
        # since the user agreed, show them the new set instead of installing it.
        agreed = sys.argv[1]
        replan = subprocess.run([HELPER, "run", "--force"], capture_output=True)
        now = state()
        if replan.returncode != 0 or now.get("state") != "ready" or fingerprint(now) != agreed:
            say(type="changed")
            return None
    retry = False
    for _ in range(3):
        say(type="password", retry=retry)
        line = sys.stdin.readline()
        if not line:
            return None
        password = line.rstrip("\n")
        if check_password(password):
            return password
        retry = True
    say(type="done", ok=False, error="The password was not accepted.")
    return None


def run_update(password):
    os.makedirs(CACHE, exist_ok=True)
    tier = state().get("tier", "")
    events = open(EVENTS, "a", buffering=1, encoding="utf-8")

    def emit(**event):
        events.write(json.dumps(event) + "\n")

    env = dict(os.environ, OMARCHY_UPDATE_UNATTENDED="1", TERM="xterm-256color", COLUMNS="120")
    pid, fd = pty.fork()
    if pid == 0:
        os.execvpe("omarchy", ["omarchy", "update", "-y"], env)

    # The terminal device of this run, to match sudo processes against.
    tty_nr = 0
    for _ in range(20):
        try:
            tty_nr = os.stat(os.readlink(f"/proc/{pid}/fd/0")).st_rdev
            break
        except OSError:
            time.sleep(0.05)
    fd_log = os.open(LOG, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.fchmod(fd_log, 0o600)
    log = os.fdopen(fd_log, "w", encoding="utf-8")
    secret = password
    buf, pending, last_phase, seen, status = b"", "", None, set(), None
    no_snapshot = False
    try:
        while status is None:
            ready, _, _ = select.select([fd], [], [], 0.5)
            if ready:
                try:
                    data = os.read(fd, 4096)
                except OSError:
                    data = b""
                if not data:
                    _, status = os.waitpid(pid, 0)
                    break
                buf = (buf + data)[-512:]
                if PROMPT.search(buf) and privileged_sudo_owns(fd, tty_nr):
                    os.write(fd, (secret + "\n").encode())
                    buf = b""
                pending += data.decode(errors="replace")
                *lines, pending = pending.split("\n")
                for line in lines:
                    clean = ANSI.sub("", line).rstrip().replace(secret, "****")
                    if not clean:
                        continue
                    if "without a snapshot" in clean:
                        no_snapshot = True
                    log.write(clean + "\n")
                    emit(type="log", line=clean[:300])
                    m = PACMAN_STEP.search(clean)
                    if m:
                        verb = "Removing" if m.group(3) == "removing" else "Installing"
                        emit(type="progress", done=int(m.group(1)), total=int(m.group(2)),
                             label=f"{verb} {m.group(4)}")
            phase = current_phase(pid)
            if phase and phase != last_phase:
                last_phase = phase
                seen.add(phase[0])
                emit(type="phase", id=phase[0], label=phase[1])
            done, st = os.waitpid(pid, os.WNOHANG)
            if done:
                status = st
    finally:
        secret = password = None
        log.close()

    code = os.waitstatus_to_exitcode(status) if status is not None else 1
    snapshot = "snapshot" in seen and bool(seen & AFTER_SNAPSHOT) and not no_snapshot
    if code == 0:
        kernel_gone = not os.path.isdir(f"/usr/lib/modules/{os.uname().release}")
        emit(type="done", ok=True, restart=kernel_gone or tier in ("restart", "major"),
             snapshot=snapshot, log=LOG)
    else:
        emit(type="done", ok=False, snapshot=snapshot, log=LOG,
             error="The update stopped with an error. Your computer was not restarted.")
    events.close()
    try:
        os.unlink(PIDFILE)
    except OSError:
        pass


def main():
    harden()
    os.makedirs(RUNTIME, mode=0o700, exist_ok=True)
    os.chmod(RUNTIME, 0o700)
    # One update at a time. The detached child keeps this lock for the run.
    lock = os.open(os.path.join(RUNTIME, "run.lock"), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        say(type="detached", events=EVENTS, resumed=True)
        return 0
    password = foreground()
    if password is None:
        return 1
    # Fresh event log, then leave the shell's process tree.
    with open(EVENTS, "w") as f:
        os.fchmod(f.fileno(), 0o600)
    if os.fork():
        os.close(lock)
        say(type="detached", events=EVENTS)
        return 0
    os.setsid()
    if os.fork():
        os._exit(0)
    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))
    devnull = os.open(os.devnull, os.O_RDWR)
    for stream in (0, 1, 2):
        os.dup2(devnull, stream)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    run_update(password)
    os._exit(0)


if __name__ == "__main__":
    sys.exit(main())
