#!/bin/bash
echo "== omarchy-update-keyring"
case omarchy-update-keyring in
  omarchy-snapshot) read -rsp "[sudo] password for tester: " pw; echo; [[ $pw == test ]] && echo "snapshot ok" || { echo "Sorry, try again."; exit 1; } ;;
  omarchy-update-system-pkgs) for i in 1 2 3; do echo "($i/3) upgrading pkg$i"; sleep 0.4; done ;;
  *) sleep 0.6 ;;
esac
