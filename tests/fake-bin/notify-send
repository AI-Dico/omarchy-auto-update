#!/bin/bash
# Fake notify-send for tests: logs its arguments, prints an id like `-p` does,
# stays "open" for FAKE_NOTIFY_HOLD seconds, "clicks" when asked to, or fails.
# Like the real one, a refused notification still prints id 0.
[[ -n ${FAKE_NOTIFY_FAIL:-} ]] && { echo 0; exit 1; }
printf '%s\n' "$*" >>"${FAKE_NOTIFY_LOG:-/dev/null}"
echo 7
sleep "${FAKE_NOTIFY_HOLD:-0}"
[[ -n ${FAKE_NOTIFY_ACTION:-} ]] && echo "$FAKE_NOTIFY_ACTION"
exit 0
